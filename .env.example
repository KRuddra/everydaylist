# ─────────────────────────────────────────────────────────────────────────────
# Everyday Guide — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# `.env.local` is read automatically by `next dev`/`next build` and by the
# db scripts (drizzle-kit, seed, rollback).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Postgres connection string.
# In Supabase: Project Settings → Database → "Connection string" → use a POOLED URL.
# Prefer the "Session pooler" (port 5432) — it works for both the app and migrations.
# (The "Transaction pooler" on port 6543 also works for the app.)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign the JWT session cookie. Must be at least 32 chars.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# bcrypt hash of your single login password (NOT the password itself).
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" "your-password"
APP_PASSWORD_HASH=""

# Fixed IANA timezone for all day-boundary / rollover logic (server side).
# e.g. America/Toronto, America/New_York, Europe/London
APP_TIMEZONE="America/Toronto"

# Client-exposed copy of APP_TIMEZONE — MUST match the value above.
NEXT_PUBLIC_APP_TIMEZONE="America/Toronto"

# Login rate limiting (optional — sensible defaults applied if omitted).
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
